---
import Logo from './Logo.astro';
import LangSwitch from './LangSwitch.astro';
import { routes, ui, type Lang, type Page } from '../i18n';

interface Props {
  lang: Lang;
  page: Page;
}

const { lang, page } = Astro.props;
const pages = Object.keys(routes) as Page[];
---

<header class="site-header sticky top-0 z-20 border-b border-line bg-bg/80 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4 sm:gap-6 sm:px-6">
    <Logo href={routes.resume[lang]} />
    <div class="flex items-center gap-4 sm:gap-7">
      <nav class="flex items-baseline gap-3 font-serif text-base italic sm:gap-5 sm:text-lg">
        {
          pages.map((p) => (
            <a
              href={routes[p][lang]}
              aria-current={p === page ? 'page' : undefined}
              class:list={['transition-colors', p === page ? 'scribble text-fg' : 'text-muted hover:text-fg']}
            >
              {ui[lang].nav[p]}
            </a>
          ))
        }
      </nav>
      <LangSwitch lang={lang} page={page} />
    </div>
  </div>
</header>
