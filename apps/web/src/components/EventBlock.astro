---
// Um evento: barra com data riscada e nome gigante que gruda no topo (lament.tv),
// polaroids que trocam sozinhas e o card com data circulada, post e links (timeline do McCartney).
import PhotoStack from './PhotoStack.astro';
import CircledDate from './CircledDate.astro';
import RoleChip from './RoleChip.astro';
import ShareButton from './ShareButton.astro';
import PixelIcon from './PixelIcon.astro';
import { dateLong, dateStamp, type EventItem } from '../data/events';
import { ui, type Lang } from '../i18n';

interface Props {
  event: EventItem;
  lang: Lang;
  eager?: boolean;
}

const { event: e, lang, eager } = Astro.props;
const t = ui[lang].events;
const name = e.name[lang];
const post = e.post[lang];
const VISIBLE = 2; // parágrafos visíveis antes do "ler o post completo"
const city = { ...e.city, name: e.city.name[lang] };
---

<article id={e.slug} class="event scroll-mt-16">
  <header class="event-bar sticky top-16 z-10 border-b border-line bg-bg/90 backdrop-blur">
    <div class="mx-auto grid max-w-6xl grid-cols-[1fr_auto] items-end gap-x-6 gap-y-1 px-6 py-3 md:grid-cols-[auto_1fr_auto]">
      <span class="display struck order-first col-span-2 text-[clamp(18px,2.2vw,28px)] text-muted md:col-span-1">{dateStamp(e)}</span>
      <h2 class="display min-w-0 text-[clamp(26px,4.2vw,56px)]">
        <a href={`#${e.slug}`} class="transition-colors hover:text-accent-light">{name}</a>
      </h2>
      <span class="label shrink-0 pb-1 text-muted md:pb-2">{city.short}</span>
    </div>
  </header>

  <div class="mx-auto grid max-w-6xl gap-12 px-6 py-14 md:grid-cols-12 md:gap-10 md:py-20">
    <div class="md:col-span-5">
      <PhotoStack photos={e.photos} alt={name} caption={city.name} nextLabel={t.nextPhoto} eager={eager} />
    </div>

    <div class="min-w-0 md:col-span-7">
      <div class="flex flex-wrap items-center gap-x-6 gap-y-4">
        <CircledDate text={dateLong(e, lang)} />
        <span class="flex flex-wrap gap-2">{e.roles.map((role) => <RoleChip role={role} lang={lang} />)}</span>
      </div>

      <h3 class="mt-7 font-serif text-[clamp(28px,3.2vw,42px)] leading-[1.05]">{e.title[lang]}</h3>

      <p class="label mt-4 flex flex-wrap items-center gap-x-3 gap-y-1 text-muted">
        <span class="flex items-center gap-2">
          {city.name}
          <PixelIcon name={e.city.id} />
        </span>
        {e.venue && <span>· {e.venue[lang]}</span>}
        {e.with && <span>· {t.with} {e.with.join(', ')}</span>}
      </p>

      <div class="post mt-8 max-w-[62ch] space-y-4 leading-relaxed text-fg/85">
        {post.slice(0, VISIBLE).map((p) => <p>{p}</p>)}
        {
          post.length > VISIBLE && (
            <details class="space-y-4">
              <summary class="label scribble inline-block cursor-pointer list-none text-fg">
                <span class="when-closed">{t.readPost}</span>
                <span class="when-open">{t.hidePost}</span>
              </summary>
              {post.slice(VISIBLE).map((p) => <p>{p}</p>)}
            </details>
          )
        }
      </div>

      <div class="mt-10 flex flex-wrap items-center justify-between gap-x-8 gap-y-4 border-t border-line pt-5">
        <ul class="flex flex-wrap gap-x-7 gap-y-2">
          {
            e.links.map((link) => (
              <li>
                <a href={link.url} target="_blank" rel="noopener" class="scribble">
                  {link.label[lang]} ↗
                </a>
              </li>
            ))
          }
        </ul>
        <ShareButton slug={e.slug} title={`${name} · César Morais`} label={t.share} copiedLabel={t.copied} />
      </div>
    </div>
  </div>
</article>

<style>
  .struck {
    text-decoration: line-through;
    text-decoration-thickness: 2px;
  }

  details summary::-webkit-details-marker {
    display: none;
  }

  details[open] > summary {
    order: 99;
  }

  details[open] {
    display: flex;
    flex-direction: column;
  }

  details[open] .when-closed,
  details:not([open]) .when-open {
    display: none;
  }

  /* Quem chega por um link de evento vê a barra acender por um instante */
  .event:target .event-bar {
    animation: target-flash 1.8s ease-out;
  }

  @keyframes target-flash {
    0%,
    30% {
      background: rgb(47 82 158 / 0.55);
    }
  }
</style>
