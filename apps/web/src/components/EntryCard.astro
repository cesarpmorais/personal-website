---
import type { Entry } from '../data/resume';
import OrgIcon from './OrgIcon.astro';

interface Props {
  entry: Entry;
}

const { entry } = Astro.props;
const { org, roles, advisor, highlights, tags } = entry;
---

<article class="border-t border-line py-10 first:border-t-0 first:pt-0">
  <header class="reveal flex items-center gap-4">
    <OrgIcon org={org} />
    <div class="min-w-0">
      <h3 class="font-serif text-[32px] leading-none">
        {org.url ? <a href={org.url} target="_blank" rel="noopener" class="transition-colors hover:text-accent-light">{org.name}</a> : org.name}
      </h3>
      {org.description && <p class="label mt-1.5 text-muted">{org.description}</p>}
    </div>
  </header>

  <!-- Cargos e períodos em linhas finas, como uma ficha técnica -->
  <dl class="reveal mt-7 border-t border-line">
    {
      roles.map((role) => (
        <div class="grid gap-x-6 gap-y-1 border-b border-line py-3 sm:grid-cols-[1fr_auto] sm:items-baseline">
          <dt class="font-medium">
            {role.title}
            {role.note && <span class="ml-2 font-serif text-base italic text-accent-light">{role.note}</span>}
          </dt>
          <dd class="label text-muted">{role.period}</dd>
        </div>
      ))
    }
  </dl>

  {
    advisor && (
      <p class="reveal mt-3 text-sm text-muted">
        {advisor.label}:{' '}
        {advisor.url ? (
          <a href={advisor.url} target="_blank" rel="noopener" class="text-fg/85 underline decoration-line underline-offset-4 hover:decoration-accent">
            {advisor.name}
          </a>
        ) : (
          advisor.name
        )}
      </p>
    )
  }

  <ul class="mt-7 max-w-[68ch] space-y-3.5 text-[15.5px] leading-relaxed text-fg/80">
    {
      highlights.map((item) => (
        <li class="reveal grid grid-cols-[20px_1fr]">
          <span class="text-accent-light" aria-hidden="true">—</span>
          <span>{item}</span>
        </li>
      ))
    }
  </ul>

  {tags && <p class="label reveal mt-7 text-muted">{tags.join(' / ')}</p>}
</article>
