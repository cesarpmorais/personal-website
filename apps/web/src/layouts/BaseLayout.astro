---
import '../styles/global.css';
import { languages, routes, type Lang, type Page } from '../i18n';
import Backdrop from '../components/Backdrop.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
// Pré-carrega as fontes para o texto não "pular" quando elas chegam depois da primeira pintura.
import interFont from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import displayFont from '@fontsource-variable/archivo/files/archivo-latin-standard-normal.woff2?url';
import serifFont from '@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url';
import pixelFont from '@fontsource/silkscreen/files/silkscreen-latin-400-normal.woff2?url';

interface Props {
  title: string;
  description?: string;
  lang: Lang;
  page: Page;
}

const { title, description = 'César Morais — software engineer.', lang, page } = Astro.props;
const site = Astro.site ?? Astro.url;
---

<html lang={languages[lang].htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0c0f" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="preload" href={interFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={serifFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={pixelFont} as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {
      (Object.keys(languages) as Lang[]).map((l) => (
        <link rel="alternate" hreflang={languages[l].htmlLang} href={new URL(routes[page][l], site).href} />
      ))
    }
    <title>{title}</title>
  </head>
  <body class="min-h-screen">
    <Backdrop />
    <SiteHeader lang={lang} page={page} />
    <slot />
    <SiteFooter lang={lang} />
  </body>
</html>
